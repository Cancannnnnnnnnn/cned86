using cned86.bddmanager;
using cned86.dal;
using MySql.Data.MySqlClient;
using System;
using System.Data;
using System.Windows.Forms;

namespace cned86
{
    /// <summary>
    /// Formulaire permettant d'ajouter une absence pour un personnel séléctionné 
    /// </summary>
    public partial class FrmAjouterAbsence : Form
    {
        private int idPersonnel;

        /// <summary>
        /// Initialise le formulaire d'ajout d'une absence 
        /// </summary>
        /// <param name="id">Identifiant du personnel</param>
        public FrmAjouterAbsence(int id)
        {
            InitializeComponent();
            idPersonnel = id;

            this.Load += FrmAjouterAbsence_Load;

            
            btnEnregistrer.Click += btnEnregistrer_Click;
            btnAnnuler.Click += (s, e) => this.Close();
        }

        /// <summary>
        /// Permet de charger les données nécessaires au formulaire (motifs, etc. ...)
        /// </summary>
        
        private void FrmAjouterAbsence_Load(object sender, EventArgs e)
        {
            LoadMotifs();

            cmbMotif.SelectedIndex = -1;
            cmbMotif.DropDownStyle = ComboBoxStyle.DropDownList;
        }

        /// <summary>
        /// Permet de charger la liste de smotifs d'aabsence dans la liste déroulante de la combobox
        /// </summary>
        private void LoadMotifs()
        {
            try
            {
                using (MySqlConnection cn = BddManager.GetConnection())
                {
                    cn.Open();

                    string query = "SELECT idmotif, libelle FROM motif";

                    MySqlDataAdapter da = new MySqlDataAdapter(query, cn);
                    DataTable dt = new DataTable();
                    da.Fill(dt);

                    cmbMotif.DataSource = dt;
                    cmbMotif.DisplayMember = "libelle";
                    cmbMotif.ValueMember = "idmotif";
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erreur chargement motifs : " + ex.Message);
            }
        }

        /// <summary>
        /// Permet d'enregistrer une nouvelle absence dans la base de données
        /// </summary>
        
        private void btnEnregistrer_Click(object sender, EventArgs e)
        {
            if (cmbMotif.SelectedIndex == -1)
            {
                MessageBox.Show("Veuillez choisir un motif !");
                return;
            }

            if (dtpDebut.Value.Date > dtpFin.Value.Date)
            {
                MessageBox.Show("La date de fin doit être après la date de début !");
                return;
            }

            try
            {
                using (MySqlConnection cn = BddManager.GetConnection())
                {
                    cn.Open();

                    string query = @"
                        INSERT INTO absence (idpersonnel, datedebut, datefin, idmotif)
                        VALUES (@id, @debut, @fin, @motif)";

                    using (MySqlCommand cmd = new MySqlCommand(query, cn))
                    {
                        cmd.Parameters.AddWithValue("@id", idPersonnel);
                        cmd.Parameters.AddWithValue("@debut", dtpDebut.Value.Date);
                        cmd.Parameters.AddWithValue("@fin", dtpFin.Value.Date);
                        cmd.Parameters.AddWithValue("@motif", cmbMotif.SelectedValue);

                        cmd.ExecuteNonQuery();
                    }
                }

                MessageBox.Show("Absence ajoutée !");
                this.DialogResult = DialogResult.OK;
                this.Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erreur ajout absence : " + ex.Message);
            }
        }

        /// <summary>
        /// Permet de fermer le formulaire sans enregistrer les modifications 
        /// </summary>
        
        private void btnAnnuler_Click(object sender, EventArgs e)
        {
            DialogResult result = MessageBox.Show(
        "Voulez-vous vraiment annuler ?",
        "Confirmation",
        MessageBoxButtons.YesNo,
        MessageBoxIcon.Question);

            if (result == DialogResult.Yes)
                this.Close();

        }
    }
}
