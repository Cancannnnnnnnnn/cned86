using cned86.bddmanager;
using cned86.dal;
using MySql.Data.MySqlClient;
using System;
using System.Data;
using System.Windows.Forms;

namespace cned86
{
    /// <summary>
    /// Formulaire permettant  d'ajouter un personnel
    /// </summary>
    public partial class FrmAjouterPersonnel : Form
    {
        /// <summary>
        /// Permet d'initialiser le formulaire d'ajout du personnel 
        /// </summary>
        public FrmAjouterPersonnel()
        {
            InitializeComponent();

            this.Load += FrmAjouterPersonnel_Load;
            btnEnregistrer.Click += btnEnregistrer_Click;
            btnAnnuler.Click += btnAnnuler_Click;
        }

        /// <summary>
        /// Permet d'initialiser les éléments du formulaire au chargement de celui-ci
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>

        private void FrmAjouterPersonnel_Load(object sender, EventArgs e)
        {
            LoadServices();
        }

        private void LoadServices()
        {
            try
            {
                cmbService.Items.Clear();

                using (MySqlConnection cn = BddManager.GetConnection())
                {
                    cn.Open();

                    string query = "SELECT idservice, nom FROM service";

                    using (MySqlCommand cmd = new MySqlCommand(query, cn))
                    using (MySqlDataReader reader = cmd.ExecuteReader())
                    {
                        int count = 0;

                        while (reader.Read())
                        {
                            string nom = reader["nom"].ToString();
                            int id = Convert.ToInt32(reader["idservice"]);

                            cmbService.Items.Add(new ComboItem(nom, id));
                            count++;
                        }

                        MessageBox.Show("Services chargés : " + count);
                    }
                }

                cmbService.DisplayMember = "Text";
                cmbService.ValueMember = "Value";

                cmbService.SelectedIndex = -1;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erreur LoadServices : " + ex.Message);
            }
        }

        
        private class ComboItem
        {
            public string Text { get; set; }
            public int Value { get; set; }

            public ComboItem(string text, int value)
            {
                Text = text;
                Value = value;
            }

            public override string ToString()
            {
                return Text;
            }
        }

        /// <summary>
        /// Permet d'enregistrer un nouveau personnel dans la base de données 
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        private void btnEnregistrer_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtNom.Text) ||
                string.IsNullOrWhiteSpace(txtPrenom.Text) ||
                string.IsNullOrWhiteSpace(txtTelephone.Text) ||
                string.IsNullOrWhiteSpace(txtMail.Text) ||
                cmbService.SelectedItem == null)
            {
                MessageBox.Show("Tous les champs doivent être remplis !");
                return;
            }

            try
            {
                ComboItem selected = (ComboItem)cmbService.SelectedItem;

                using (MySqlConnection cn = BddManager.GetConnection())
                {
                    cn.Open();

                    string query = @"
                        INSERT INTO personnel (nom, prenom, tel, mail, idservice)
                        VALUES (@nom, @prenom, @tel, @mail, @service)";

                    using (MySqlCommand cmd = new MySqlCommand(query, cn))
                    {
                        cmd.Parameters.AddWithValue("@nom", txtNom.Text.Trim());
                        cmd.Parameters.AddWithValue("@prenom", txtPrenom.Text.Trim());
                        cmd.Parameters.AddWithValue("@tel", txtTelephone.Text.Trim());
                        cmd.Parameters.AddWithValue("@mail", txtMail.Text.Trim());
                        cmd.Parameters.AddWithValue("@service", selected.Value);

                        cmd.ExecuteNonQuery();
                    }
                }

                MessageBox.Show("Personnel ajouté avec succès");
                this.Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erreur insertion : " + ex.Message);
            }
        }

        /// <summary>
        /// Permet après confirmation de fermer le formulaire sans enregistrer les modifications
        /// </summary>
        /// <param name="sender"></param>
        /// <param name="e"></param>
        private void btnAnnuler_Click(object sender, EventArgs e)
        {
            DialogResult result = MessageBox.Show(
       "Voulez-vous vraiment annuler ?",
       "Confirmation",
       MessageBoxButtons.YesNo,
       MessageBoxIcon.Question);

            if (result == DialogResult.Yes)
                this.Close();
        }

    }
}
